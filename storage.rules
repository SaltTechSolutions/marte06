rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin via Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public assets (logo, etc.)
    match /settings/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member-specific files (future: profile photos, documents)
    match /members/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Default: only admins can access other paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
